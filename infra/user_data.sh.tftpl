#!/bin/bash
# Boot script rendered by Terraform templatefile(). Installs Docker, pulls the exact
# image tag from ECR and runs it with logs shipped to CloudWatch Logs.
set -euxo pipefail

dnf install -y docker jq
systemctl enable --now docker

REGION="${region}"
IMAGE="${image}"
REGISTRY="$(echo "$IMAGE" | cut -d/ -f1)"

aws ecr get-login-password --region "$REGION" \
  | docker login --username AWS --password-stdin "$REGISTRY"
docker pull "$IMAGE"

# Secrets are fetched at start-up. They never appear in the pipeline, the image or Terraform state.
# If the secret has no value yet, the app starts with an empty env file.
touch /etc/app.env
chmod 600 /etc/app.env
aws secretsmanager get-secret-value --region "$REGION" --secret-id "${secret_id}" \
  --query SecretString --output text 2>/dev/null \
  | jq -r 'to_entries[] | "\(.key)=\(.value)"' > /etc/app.env || true

# IMAGE_TAG is what /<service>/version returns, so the smoke test can prove the new build is live
docker run -d --name app --restart unless-stopped \
  -p ${port}:${port} \
  -e PORT=${port} \
  -e IMAGE_TAG=${image_tag} \
  --env-file /etc/app.env \
  --log-driver=awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="${log_group}" \
  "$IMAGE"
